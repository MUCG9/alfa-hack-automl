+    def temporary_pair(self):
+        short=ROOT.parent/'t';short.mkdir(exist_ok=True)
+        temporary=tempfile.TemporaryDirectory(prefix='fdd-',dir=short);self.addCleanup(temporary.cleanup)
+        root=Path(temporary.name);a=root/'a';b=root/'b';a.mkdir();b.mkdir();return a,b

+def exact_npz(path,train,validation,expected):
+    import numpy as np
+    path=Path(path)
+    if path.exists():raise Blocked('immutable_split_exists')
+    np.savez(path,train=train,validation=validation)
+    actual=sha(path)
+    if actual!=expected:raise Blocked('exact_original_npz_bytes_not_reproduced')
+    return actual

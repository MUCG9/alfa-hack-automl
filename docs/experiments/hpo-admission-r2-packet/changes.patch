+            study = report['cuts'][0]['tpe']
+            study['trials'].append({'status': 'timeout', 'objective_valid': False, 'value': 0.})
+            study.update(attempted_trials=3, unattempted_trials=5)
+        self.change(paths[1], failed)
+        result = qualify_reports(plan, 'regression', paths)
+        self.assertFalse(result['valid_equal_budget_screen'])
+        self.assertIn('numeric failed', result['errors'][0]['reason'])
+
+

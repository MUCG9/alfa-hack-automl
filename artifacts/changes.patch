+def model_admission(job,claim):
+    if job.get('kind')!='bounded_experiment' or job['caps'].get('max_fits',0)<=0:
+        raise Blocked('source_only_model_fit_forbidden')
+    if not job.get('dependencies') or not claim.get('primary_approval_verified',False):raise Blocked('independent_primary_approval_required')
+    if time.time()>=claim['deadline_unix']:raise Blocked('original_deadline_expired')

+"""Read-only validity gate for the predeclared HPO admission component screen.
+
+Lifecycle completion is not qualification. This tool never fits a model,
+selects a recipe, calls an API, or promotes a release.
+"""
+from pathlib import Path
+import argparse
+import hashlib
+import json
+import math
+import zipfile
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def digest(path):
+    value = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for block in iter(lambda: stream.read(2**20), b''):
+            value.update(block)
+    return value.hexdigest()
+
+
+def canonical(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
+                                   ensure_ascii=False, allow_nan=False).encode('utf-8')).hexdigest()
+
+
+def finite(value):
+    return not isinstance(value, bool) and isinstance(value, (int, float)) and math.isfinite(value)
+
+
+def partition(path, expected, n_rows):
+    if Path(path).stat().st_size > 32 * 2**20:
+        raise ValueError('partition byte bound')
+    with zipfile.ZipFile(path) as archive:
+        entries = archive.infolist()
+        if (len(entries) != 2 or {entry.filename for entry in entries} != {'train.npy', 'validation.npy'}
+                or sum(entry.file_size for entry in entries) > 32 * 2**20):
+            raise ValueError('partition expanded byte bound or inventory')
+    with np.load(path, allow_pickle=False) as stored:
+        if set(stored.files) != {'train', 'validation'}:
+            raise ValueError('partition arrays')
+        tr, va = stored['train'], stored['validation']
+    for rows in [tr, va]:
+        if (rows.ndim != 1 or not len(rows) or not np.issubdtype(rows.dtype, np.integer)
+                or len(np.unique(rows)) != len(rows) or rows.min() < 0 or rows.max() >= n_rows):
+            raise ValueError('partition row positions')
+    if np.intersect1d(tr, va).size:
+        raise ValueError('partition overlap')
+    actual = hashlib.sha256(tr.astype('<i8').tobytes() + va.astype('<i8').tobytes()).hexdigest()
+    if actual != expected:
+        raise ValueError('partition index fingerprint')
+    return tr, va
+
+
+def qualify_reports(plan, task, paths, *, harness_root=None):
+    """Validate all declared cuts/policies, then expose descriptive comparisons."""
+    errors, arms, spec_fingerprint = [], {}, None
+    harness_root = ROOT if harness_root is None else Path(harness_root).resolve()
+    metric = 'rmse' if task == 'regression' else 'macro_f1'
+    greater = task == 'classification'
+    control = plan['controls'][task]
+    expected_cuts = {pair['cut'] for pair in plan['pairs'] if pair['task'] == task}
+    expected_arms = {(policy, cut) for policy in ['legacy', 'measured'] for cut in expected_cuts}
+    expected_source = plan['qualification']['expected_source_sha256']
+    expected_harness = plan['qualification']['expected_harness_sha256']
+    if any(plan['limits'].get(key) != value for key, value in {
+            'study_seconds': 900, 'maximum_trials_including_anchor': 8, 'sampler_seed': 137,
+            'tpe_startup_trials': 3, 'worker_seconds': 600, 'worker_memory_mib': 1536, 'worker_threads': 2}.items()):
+        raise ValueError('Predeclared qualification resource protocol changed')
+    if not expected_source or not expected_harness or not expected_cuts:
+        raise ValueError('Frozen qualification manifest is required')
+    for path in map(Path, paths):
+        try:
+            report = json.loads(path.read_text(encoding='utf-8'))
+            limits, spec = report['limits'], report['spec']
+            policy = limits['admission']
+            if policy not in {'legacy', 'measured'} or report['mode'] != 'hpo':
+                raise ValueError('admission or mode')
+            if report['status'] != 'completed' or not all(report.get(key) is True for key in
+                    ['source_unchanged', 'inputs_unchanged', 'task_unchanged', 'harness_unchanged']):
+                raise ValueError('lifecycle or integrity not complete')
+            for key, expected in [('trials', 8), ('study_seconds', 900), ('worker_seconds', 600),
+                                  ('memory_mb', 1536), ('worker_threads', 2)]:
+                if limits.get(key) != expected or isinstance(limits.get(key), bool):
+                    raise ValueError('unequal declared resource: ' + key)
+            if spec['kind'] != task or spec['metric'] != metric or spec['greater_is_better'] is not greater:
+                raise ValueError('task metric or direction')
+            if spec_fingerprint is None:
+                spec_fingerprint = canonical(spec)
+            elif canonical(spec) != spec_fingerprint:
+                raise ValueError('policy task specifications differ')
+            if canonical(report['control_recipe']) != control['recipe_sha256_canonical_json']:
+                raise ValueError('changed SINGLE control')
+            if report['source_sha256'] != expected_source or report['harness_sha256'] != expected_harness:
+                raise ValueError('changed frozen source or harness')
+            sources = path.parent / 'sources'
+            if {p.name for p in sources.iterdir() if p.is_file()} != set(expected_source):
+                raise ValueError('source artifact inventory')
+            for name, expected in expected_source.items():
+                if Path(name).name != name or digest(sources / name) != expected:
+                    raise ValueError('source artifact fingerprint')
+            for name, expected in expected_harness.items():
+                path_in_root = (harness_root/name).resolve()
+                if Path(name).is_absolute() or not path_in_root.is_relative_to(harness_root) or digest(path_in_root) != expected:
+                    raise ValueError('current harness fingerprint')
+            expected_inputs = control['input_sha256']
+            if report['task_sha256'] != expected_inputs['task.md'] or digest(limits['task']) != report['task_sha256']:
+                raise ValueError('task fingerprint')
+            if set(report['input_sha256']) != set(spec['paths']):
+                raise ValueError('input inventory')
+            if {Path(p).name for p in spec['paths'].values()} != set(expected_inputs) - {'task.md'}:
+                raise ValueError('input filename inventory')
+            for role, name in spec['paths'].items():
+                expected = expected_inputs[Path(name).name]
+                if report['input_sha256'][role] != expected or digest(name) != expected:
+                    raise ValueError('input fingerprint')
+            cuts = report['cuts']
+            if not cuts or len({row['cut'] for row in cuts}) != len(cuts):
+                raise ValueError('empty or duplicate cuts')
+            for row in cuts:
+                key = policy, row['cut']
+                if key not in expected_arms or key in arms:
+                    raise ValueError('unexpected or repeated policy/cut')
+                directory = path.parent / ('cut-' + str(row['cut']))
+                outer_path = directory / 'outer-split.npz'
+                if digest(outer_path) != row['outer_split_sha256']:
+                    raise ValueError('outer partition artifact fingerprint')
+                outer_tr, _ = partition(outer_path, row['split']['split_sha256'], spec['n_train'])
+                if greater and row['split'].get('shared_feature_hashes') != 0:
+                    raise ValueError('outer fitting groups overlap')
+                values, inner_hashes, guided = {}, [], {}
+                if set(row['outcomes']) != {'control', 'random', 'tpe'}:
+                    raise ValueError('outer outcome inventory')
+                for name, result in row['outcomes'].items():
+                    value = (result.get('metrics') or {}).get(metric)
+                    if result.get('status') != 'ok' or not finite(value) or value < 0 or (greater and value > 1):
+                        raise ValueError('unsuccessful or nonnumeric outer outcome: ' + name)
+                    values[name] = float(value)
+                if canonical(row['outcomes']['control']['recipe']) != canonical(report['control_recipe']):
+                    raise ValueError('outer control recipe')
+                for sampler in ['random', 'tpe']:
+                    allocation = row['study_allocations'][sampler]
+                    if (allocation['requested_seconds'] != 900 or not finite(allocation['allocated_seconds'])
+                            or not math.isclose(allocation['allocated_seconds'], 900., rel_tol=0, abs_tol=1e-6)
+                            or allocation['clipped_by_common_deadline'] is not False):
+                        raise ValueError('externally clipped study allocation')
+                    study = row[sampler]
+                    if (study['sampler'] != sampler or study['seed'] != 137 or study['maximum_trials'] != 8
+                            or study['startup_trials'] != 3 or study['admission_policy'] != policy
+                            or canonical(study['control_recipe']) != canonical(report['control_recipe'])):
+                        raise ValueError('changed inner study protocol')
+                    if not finite(study['seconds']) or study['seconds'] < 0:
+                        raise ValueError('invalid elapsed study time')
+                    split = study['split']
+                    inner_tr, inner_va = partition(directory / sampler / 'split.npz', split['split_sha256'], spec['n_train'])
+                    if split['scope'] != 'inside_outer_fitting_rows_only' or not (set(inner_tr) | set(inner_va)) <= set(outer_tr):
+                        raise ValueError('inner rows escape outer fitting partition')
+                    if greater and split.get('shared_feature_hashes') != 0:
+                        raise ValueError('inner fitting groups overlap')
+                    inner_hashes.append(split['split_sha256'])
+                    valid = [trial for trial in study['trials'] if trial.get('objective_valid')]
+                    if (study['attempted_trials'] != len(study['trials']) or study['completed_trials'] != len(valid)
+                            or study['unattempted_trials'] != 8 - len(study['trials']) or len(study['trials']) > 8):
+                        raise ValueError('inner work accounting')
+                    for trial in study['trials']:
+                        if trial.get('objective_valid'):
+                            if trial.get('status') != 'ok' or not finite(trial.get('value')):
+                                raise ValueError('invalid successful inner objective')
+                        elif trial.get('value') is not None:
+                            raise ValueError('numeric failed inner objective')
+                    if valid:
+                        best = (max if greater else min)(trial['value'] for trial in valid)
+                        if study['status'] != 'ok' or study['best_inner_value'] != best:
+                            raise ValueError('inner winner objective')
+                        if not any(trial['value'] == best and trial['recipe'] == study['selected_recipe'] for trial in valid):
+                            raise ValueError('inner winner recipe')
+                    elif study['status'] != 'no_successful_trials' or study.get('best_inner_value') is not None or study['selected_recipe'] != report['control_recipe']:
+                        raise ValueError('all-failed fallback')
+                    if row['outcomes'][sampler]['recipe'] != study['selected_recipe']:
+                        raise ValueError('outer refit differs from selected recipe')
+                    guided[sampler] = study['guided_successful_trials']
+                if len(set(inner_hashes)) != 1:
+                    raise ValueError('random/TPE inner partitions differ')
+                arms[key] = {'values': values, 'outer_split': row['split']['split_sha256'],
+                             'inner_split': inner_hashes[0], 'successful_guided_trials': guided}
+        except (KeyError, TypeError, ValueError, OSError, EOFError, zipfile.BadZipFile) as exc:
+            errors.append({'report': str(path), 'reason': str(exc)[:300]})
+    if set(arms) != expected_arms:
+        errors.append({'reason': 'missing complete predeclared policy/cut pairs'})
+    for cut in expected_cuts:
+        pair = [arms.get((policy, cut)) for policy in ['legacy', 'measured']]
+        if all(pair) and any(pair[0][key] != pair[1][key] for key in ['outer_split', 'inner_split']):
+            errors.append({'cut': cut, 'reason': 'policy partitions differ'})
+        if all(pair) and pair[0]['values']['control'] != pair[1]['values']['control']:
+            errors.append({'cut': cut, 'reason': 'unchanged control outer metric drift'})
+    comparisons = []
+    if not errors:
+        for cut in sorted(expected_cuts):
+            legacy, measured = [arms[(policy, cut)] for policy in ['legacy', 'measured']]
+            comparisons.append({'cut': cut,
+                'measured_minus_legacy': {name: measured['values'][name] - legacy['values'][name] for name in ['control', 'random', 'tpe']},
+                'tpe_minus_random': {policy: arms[(policy, cut)]['values']['tpe'] - arms[(policy, cut)]['values']['random'] for policy in ['legacy', 'measured']},
+                'successful_guided_trials': {policy: arms[(policy, cut)]['successful_guided_trials']['tpe'] for policy in ['legacy', 'measured']}})
+    means = ({policy: {name: float(np.mean([arms[(policy, cut)]['values'][name] for cut in expected_cuts]))
+                      for name in ['control', 'random', 'tpe']} for policy in ['legacy', 'measured']} if not errors else None)
+    return {'valid_equal_budget_screen': not errors, 'task': task, 'metric': metric, 'errors': errors,
+            'comparisons': comparisons, 'outer_metric_means': means, 'failed_metric_substitution': False,
+            'ml_quality_promotion_gate_evaluated': False, 'promotion': False,
+            'limitations': ['Validity of saved artifacts/status/protocol only; outer metrics are not recomputed from predictions.',
+                'Measured early admission stopping is valid with a full initial allocation; externally clipped caps are not equal-budget evidence.',
+                'Admission chronology and stop reasons are not replayed by this gate; they rely on the frozen HPO implementation and its separate focused tests.',
+                'A valid negative screen remains evidence. Per-class support, entire-selection CV and full-agent/release gates remain required.']}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--plan', type=Path, required=True)
+    parser.add_argument('--task', choices=['regression', 'classification'], required=True)
+    parser.add_argument('--reports', type=Path, nargs='+', required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    result = qualify_reports(json.loads(args.plan.read_text(encoding='utf-8')), args.task, args.reports)
+    with args.output.open('xb') as stream:
+        stream.write((json.dumps(result, ensure_ascii=False, indent=2, allow_nan=False) + '\n').encode('utf-8'))
+    if not result['valid_equal_budget_screen']:
+        raise SystemExit(1)
+
+
+if __name__ == '__main__':
+    main()

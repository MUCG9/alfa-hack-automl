+    before=file_ref(path,check)
+    if before['sha256']!=args.hpo_trial_bank_sha256:raise BankRejected('bank_manifest_changed')
+    def pairs(rows):
+        value={}
+        for key,item in rows:
+            if key in value:raise BankRejected('bank_manifest_duplicate_key')
+            value[key]=item
+        return value
+    def nonfinite(value):raise BankRejected('bank_manifest_nonfinite')
+    value=json.loads(path.read_text('utf-8'),object_pairs_hook=pairs,parse_constant=nonfinite)
+    if (type(value) is not dict or set(value)!={'schema','source_refs','input_refs','native_refs'}
+            or value['schema']!='hpo-trial-bank-opt-in-v1'):
+        raise BankRejected('closed_bank_optin_manifest_required')
+    if file_ref(path,check)!=before:raise BankRejected('bank_manifest_changed_during_read')
+    return dict(manifest=before,payload=value)

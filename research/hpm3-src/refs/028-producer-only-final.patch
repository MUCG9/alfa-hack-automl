+def _bank_recorder(job):
+    from automl.infrastructure.hpo_bank import FitIdentityRecorder,checked_refs,need,supported_recipe
+    request=job['_hpo_trial_bank']
+    def check():
+        # Parent supplied its existing cleanup-inclusive deadline. No new clock.
+        if time.monotonic()>=request['original_worker_deadline_monotonic']:
+            raise TimeoutError('hpo_bank_original_worker_deadline')
+    check()
+    for key in ('source_refs','input_refs','native_refs'):checked_refs(request[key],check)
+    recorder=FitIdentityRecorder(job,check)
+    if not supported_recipe(job['recipe']) or request.get('supported') is not True:
+        recorder.reject('unsupported_bank_recipe')
+    return recorder

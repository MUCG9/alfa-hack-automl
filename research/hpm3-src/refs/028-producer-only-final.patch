+def _bank_after_fit(recorder,token,estimator):
+    from automl.infrastructure.hpo_bank import BankRejected
+    if recorder.nodes[token]['status']=='unqualified':return
+    try:
+        booster=getattr(estimator,'booster_',None)
+        if booster is None or type(booster.params) is not dict:raise BankRejected('actual_fitted_booster_parameters_missing')
+        effective=dict(constructor=_bank_value(estimator.get_params(deep=False),recorder.checkpoint),
+            fitted_booster=_bank_value(booster.params,recorder.checkpoint),
+            best_iteration=_bank_value(getattr(estimator,'best_iteration_',None),recorder.checkpoint),
+            actual_iteration_count=_bank_value(booster.current_iteration(),recorder.checkpoint),
+            actual_tree_count=_bank_value(booster.num_trees(),recorder.checkpoint),
+            feature_names=_bank_value(booster.feature_name(),recorder.checkpoint),native=_bank_native(recorder))
+        recorder.after_fit(token,effective)
+    except (BankRejected,AttributeError,TypeError,ValueError) as exc:
+        reason=str(exc) if isinstance(exc,BankRejected) else 'unsupported_actual_effective_descriptor_'+type(exc).__name__
+        recorder.reject(reason);recorder.nodes[token].update(status='unqualified',reason=reason)

+def audit_component(spec,raw_train,expected_rows,output):
+    """Prospective independent auditor; NEVER trains or accepts reported scalar scores."""
+    import numpy as np
+    import pandas as pd
+    from automl_evaluation import evaluate
+    from automl_publishing import read_submission_values
+    from automl_infrastructure_tables import read_input_table
+    output=Path(output);actual=pd.read_csv(output/'validation_predictions.csv')
+    sample=read_input_table(spec['paths']['sample_submission']);test=read_input_table(spec['paths']['test'])
+    exported_frame=pd.read_csv(output/'submission.csv')
+    if list(exported_frame.columns)!=list(sample.columns) or len(exported_frame)!=len(test) or len(sample)!=len(test) or exported_frame.isna().any().any():raise Blocked('auditor_export_shape_schema')
+    if spec.get('id') and not np.array_equal(exported_frame[spec['id']],sample[spec['id']]):raise Blocked('auditor_export_ids')
+    exported=read_submission_values(spec,output/'submission.csv')
+    if len(exported)==0:raise Blocked('auditor_empty_export')
+    if not np.array_equal(actual.row_position.to_numpy(),expected_rows):raise Blocked('auditor_row_order_mismatch')
+    truth=raw_train[spec['target']].iloc[expected_rows].to_numpy()
+    if spec['kind']=='classification':
+        if not np.array_equal(actual.y_true.astype(str).to_numpy(),truth.astype(str)):raise Blocked('auditor_truth_mismatch')
+        with np.load(output/'validation_probabilities.npz',allow_pickle=False) as cache:
+            if cache['classes'].astype(str).tolist()!=spec['classes'] or not np.array_equal(cache['row_position'],expected_rows):raise Blocked('auditor_probability_alignment')
+            probabilities=cache['probabilities'].copy()
+        if not np.isfinite(probabilities).all() or np.any(probabilities<0) or not np.allclose(probabilities.sum(axis=1),1,atol=1e-6):raise Blocked('auditor_probability_values')
+        predicted=np.asarray(spec['classes'])[probabilities.argmax(axis=1)]
+        if not np.array_equal(predicted,actual.y_pred.astype(str).to_numpy()):raise Blocked('auditor_decision_mismatch')
+    else:
+        if not np.allclose(truth.astype(float),actual.y_true.to_numpy(),rtol=0,atol=1e-10):raise Blocked('auditor_truth_mismatch')
+        predicted=actual.y_pred.to_numpy();probabilities=None
+        if not np.isfinite(predicted).all():raise Blocked('auditor_nonfinite_prediction')
+    return evaluate(truth,predicted,spec['kind'],spec['metric'],probabilities,spec.get('classes'))

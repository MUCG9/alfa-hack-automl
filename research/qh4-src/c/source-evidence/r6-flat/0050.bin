"""SHA/AST/compile source-core freeze. Never imports or runs task/test sources."""
from pathlib import Path
import ast
import hashlib
import json

HERE=Path(__file__).resolve().parent;WORK=HERE.parent;CANONICAL=WORK/'alfa-hack-automl'
def sha(path):return hashlib.sha256(Path(path).read_bytes()).hexdigest()
def save(name,value):(HERE/name).write_text(json.dumps(value,indent=2,ensure_ascii=False,allow_nan=False)+'\n',encoding='utf-8')
methods={}
for filename in ['test_research_loop.py','test_r5_worker_consumer.py']:
    path=HERE/filename;tree=ast.parse(path.read_bytes());compile(path.read_bytes(),filename,'exec')
    declared={c.name+'.'+m.name:hashlib.sha256(ast.dump(m,include_attributes=False).encode()).hexdigest()
        for c in tree.body if isinstance(c,ast.ClassDef) for m in c.body if isinstance(m,ast.FunctionDef) and m.name.startswith('test_')}
    assert len(declared)==len(set(declared))
    methods[filename]={'sha256':sha(path),'prepared_method_count':len(declared),'methods_AST_sha256':declared,'actual_executed':0}
assert sum(v['prepared_method_count'] for v in methods.values())==17
for filename in ['research_loop.py','task_entry.py','gateway_child.py','r5_worker_runtime.py','r5_resources.py','verified_sampling.py']:
    compile((HERE/filename).read_bytes(),filename,'exec')

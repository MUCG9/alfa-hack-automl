        "feature_code": "def transform(df):\n    df = df.copy()\n    \n    # Ratio of floor area to heating degree days (larger buildings in cold climates may have different EUI)\n    df['area_hdd_ratio'] = df['floor_area'] / (df['heating_degree_days_c'] + 1e-6)\n    \n    # Ratio of floor area to cooling degree days\n    df['area_cdd_ratio'] = df['floor_area'] / (df['cooling_degree_days_c'] + 1e-6)\n    \n    # Interaction between building class and energy star rating (commercial vs residential efficiency)\n    df['is_commercial'] = (df['building_class'] == 'Commercial').astype(int)\n    df['class_star_interact'] = df['is_commercial'] * df['energy_star_rating']\n    \n    # Ratio of heating to cooling degree days (climate balance)\n    df['hdd_cdd_ratio'] = df['heating_degree_days_c'] / (df['cooling_degree_days_c'] + 1e-6)\n    \n    return df"
      }

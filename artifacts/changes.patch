+def container_diagnostic(path,expected):
+    """Read-only diagnosis, NEVER a replacement for the required raw-byte gate."""
+    raw=Path(path).read_bytes();copy=bytearray(raw);changes=[]
+    with zipfile.ZipFile(path) as packed:
+        members=[{'name':m.filename,'creator_system':m.create_system,'crc':m.CRC,
+            'uncompressed_member_sha256':hashlib.sha256(packed.read(m.filename)).hexdigest()} for m in packed.infolist()]
+    # ZIP central directory version-made-by high byte is OS, not array payload.
+    end=raw.rfind(b'PK\x05\x06')
+    if end<0:raise Blocked('zip_directory_unavailable')
+    entries=struct.unpack_from('<H',raw,end+10)[0]
+    at=struct.unpack_from('<I',raw,end+16)[0]
+    if entries!=len(members):raise Blocked('zip64_or_unsupported_directory')
+    for _ in range(entries):
+        if raw[at:at+4]!=b'PK\x01\x02':raise Blocked('zip_directory_boundary')
+        if copy[at+5]!=0:changes.append(at+5);copy[at+5]=0
+        name,extra,comment=struct.unpack_from('<HHH',raw,at+28)
+        at+=46+name+extra+comment
+    candidate=hashlib.sha256(copy).hexdigest()
+    return {'raw_sha256':hashlib.sha256(raw).hexdigest(),'expected_sha256':expected,
+        'raw_bytes_match':hashlib.sha256(raw).hexdigest()==expected,'members':members,
+        'windows_creator_only_diagnostic_sha256':candidate,
+        'windows_creator_only_diagnostic_matches':candidate==expected,
+        'changed_in_memory_bytes':len(changes),'file_modified':False,
+        'array_payload_modified':False,'diagnostic_is_NOT_gate_acceptance':True}
+

+"""Chronological fake workers and real samplers; no model fits or API calls."""
+from copy import deepcopy
+from pathlib import Path
+import json
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'src'))
+sys.path.insert(0,str(ROOT/'tests'))
+import numpy as np
+from automl.search import hpo
+from test_hpo import fixture
+
+
+class Clock:
+    def __init__(self): self.now=0.
+    def __call__(self): return self.now
+
+
+class HPOAdmissionTests(unittest.TestCase):
+    def study(self,durations,*,budget=100.,values=None,statuses=None,sampler='tpe',
+              admission='measured',trials=8,worker_timeout=600,poison=False,checkpoint_seconds=0.):
+        spec,train,hashes,rows,recipe=fixture()
+        original=deepcopy(recipe)
+        if poison: train.loc[140:,'answer']=1e30
+        clock=Clock();calls=[]
+        with tempfile.TemporaryDirectory() as directory:
+            def worker(task,candidate,out,split,timeout):
+                number=len(calls)
+                # A forbidden future trial would fail, rather than expose its timing.
+                self.assertLess(number,len(durations))
+                with np.load(split) as stored:
+                    self.assertTrue(set(stored['train'])|set(stored['validation'])<=set(rows))
+                    inner_value=float(abs(train.answer.iloc[stored['validation']].mean()))
+                calls.append({'params':candidate['params'],'timeout':timeout,'started':clock.now})
+                clock.now+=durations[number]
+                return {'status':statuses[number] if statuses else 'ok',
+                    'metrics':{'rmse':values[number] if values is not None else inner_value+10-number},
+                    # Admission must use observed elapsed time, not this mismatched report.
+                    'wall_seconds':999.}
+            kwargs={} if admission is None else {'admission':admission}
+            real_atomic_json=hpo.atomic_json
+            def checkpoint(path,record):
+                real_atomic_json(path,record)
+                clock.now+=checkpoint_seconds
+            with patch.object(hpo.time,'monotonic',clock),patch.object(hpo,'atomic_json',checkpoint):
+                selected,report=hpo.optimize_recipe(spec,train,hashes,rows,recipe,
+                    Path(directory)/'study',worker,budget,trials=trials,sampler=sampler,
+                    worker_timeout=worker_timeout,**kwargs)
+            stored=json.loads((Path(directory)/'study/hpo.json').read_text())
+            self.assertEqual(stored,json.loads(json.dumps(report)))
+        self.assertEqual(recipe,original)
+        return selected,report,calls,recipe
+
+    def test_history_is_chronological_and_uses_past_median(self):
+        _,report,calls,_=self.study([20.,10.,5.],trials=3)
+        self.assertEqual(len(calls),3)
+        decisions=report['admission_decisions']
+        self.assertEqual([d['estimated_seconds'] for d in decisions],[None,30.,22.5])
+        self.assertEqual([d['remaining_seconds'] for d in decisions],[100.,80.,70.])
+        self.assertEqual(report['successful_worker_durations'],[20.,10.,5.])
+
+    def test_unfit_next_worker_is_not_sampled_or_started_and_anchor_survives(self):
+        selected,report,calls,_=self.study([20.],budget=40.)
+        self.assertEqual(len(calls),1)
+        self.assertEqual(selected,report['trials'][0]['recipe'])
+        decision=report['admission_decisions'][-1]
+        self.assertFalse(decision['admitted'])
+        self.assertEqual((decision['remaining_seconds'],decision['estimated_seconds']),(20.,30.))
+        self.assertEqual(decision['skipped_trials'],7)
+        self.assertEqual(report['unattempted_trials'],7)
+
+    def test_exact_boundary_is_admitted(self):
+        _,report,calls,_=self.study([20.,20.],budget=50.,trials=2)
+        self.assertEqual(len(calls),2)
+        self.assertTrue(report['admission_decisions'][1]['admitted'])
+        self.assertEqual(report['admission_decisions'][1]['remaining_seconds'],30.)
+
+    def test_checkpoint_overhead_is_rechecked_before_unique_worker_launch(self):
+        _,report,calls,_=self.study([20.],budget=52.,trials=2,checkpoint_seconds=1.)
+        self.assertEqual(len(calls),1)
+        decision=report['admission_decisions'][-1]
+        self.assertEqual(decision['remaining_seconds'],30.)
+        self.assertEqual(decision['pre_worker_remaining_seconds'],29.)
+        self.assertFalse(decision['admitted'])
+        self.assertTrue(decision['sampled_but_not_started'])
+        self.assertEqual(decision['reason'],'insufficient_remaining_before_worker')
+        self.assertEqual(report['attempted_trials'],1)
+
+    def test_no_startup_reservation_can_discard_an_admitted_startup_winner(self):
+        selected,report,calls,_=self.study([20.,50.],budget=95.,values=[10.,1.])
+        self.assertEqual(len(calls),2)
+        self.assertEqual([row['sampling_phase'] for row in report['trials']],['anchor','startup'])
+        self.assertEqual(report['best_inner_value'],1.)
+        self.assertEqual(selected,report['trials'][1]['recipe'])
+        self.assertEqual(report['guided_attempts'],0)
+
+    def test_default_and_explicit_legacy_preserve_full_search_trace(self):
+        implicit=self.study([20.,20.],budget=40.,admission=None)
+        explicit=self.study([20.,20.],budget=40.,admission='legacy')
+        self.assertEqual(implicit,explicit)
+        self.assertEqual(len(implicit[2]),2)
+        self.assertTrue(all(d['estimated_seconds'] is None for d in implicit[1]['admission_decisions']))
+
+    def test_sufficient_budget_preserves_sampler_trace_for_both_policies(self):
+        for sampler in ['random','tpe']:
+            legacy=self.study([10.]*8,budget=900.,sampler=sampler,admission='legacy')
+            measured=self.study([10.]*8,budget=900.,sampler=sampler)
+            self.assertEqual(legacy[0],measured[0])
+            self.assertEqual(legacy[2],measured[2])
+            self.assertEqual(legacy[1]['trials'][0]['params'],measured[1]['trials'][0]['params'])
+
+    def test_random_and_tpe_apply_identical_admission_to_fixed_durations(self):
+        random=self.study([20.,30.],budget=80.,sampler='random')
+        tpe=self.study([20.,30.],budget=80.,sampler='tpe')
+        self.assertEqual(random[1]['admission_decisions'],tpe[1]['admission_decisions'])
+        self.assertEqual(len(random[2]),2)
+
+    def test_failed_worker_does_not_reduce_estimate_or_become_numeric_objective(self):
+        _,report,calls,_=self.study([20.,5.,10.],statuses=['ok','timeout','ok'],trials=3)
+        self.assertEqual(len(calls),3)
+        self.assertEqual(report['successful_worker_durations'],[20.,10.])
+        self.assertEqual(report['admission_decisions'][2]['estimated_seconds'],30.)
+        self.assertIsNone(report['trials'][1]['value'])
+
+    def test_all_failed_trials_preserve_original_control(self):
+        selected,report,calls,recipe=self.study([10.]*8,statuses=['timeout']*8,
+            budget=100.,worker_timeout=40)
+        self.assertEqual(selected,recipe)
+        self.assertEqual(report['status'],'no_successful_trials')
+        self.assertEqual(report['successful_worker_durations'],[])
+        self.assertEqual(report['completed_trials'],0)
+        self.assertEqual(len(calls),7)
+        self.assertTrue(all(row['value'] is None for row in report['trials']))
+
+    def test_zero_duration_success_uses_worker_cap_instead_of_zero_estimate(self):
+        selected,report,calls,_=self.study([0.],budget=50.,worker_timeout=60)
+        self.assertEqual(len(calls),1)
+        self.assertEqual(selected,report['trials'][0]['recipe'])
+        self.assertEqual(report['invalid_successful_duration_count'],1)
+        self.assertEqual(report['admission_decisions'][-1]['estimated_seconds'],60.)
+        self.assertEqual(report['successful_worker_durations'],[])
+
+    def test_invalid_policy_or_worker_cap_is_rejected_before_worker(self):
+        for admission,cap in [('unknown',600),('measured',float('nan')),
+                              ('measured',float('inf')),('measured',0),('measured',-1),('measured',True)]:
+            with self.subTest(admission=admission,cap=cap),self.assertRaises(ValueError):
+                self.study([],admission=admission,worker_timeout=cap)
+
+    def test_poisoned_outer_labels_do_not_change_decisions_or_inner_winner(self):
+        for sampler in ['random','tpe']:
+            clean=self.study([10.]*6,budget=900.,trials=6,sampler=sampler)
+            poisoned=self.study([10.]*6,budget=900.,trials=6,sampler=sampler,poison=True)
+            self.assertEqual(clean,poisoned)
+
+
+if __name__=='__main__': unittest.main(verbosity=2)

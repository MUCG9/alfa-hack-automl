+"""Synthetic frozen reports/NPZ partitions only; no learner, fit or API."""
+from copy import deepcopy
+import hashlib
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT/'tools'))
+from qualify_hpo import canonical, digest, qualify_reports as _qualify_reports
+
+
+def qualify_reports(plan, task, paths):
+    return _qualify_reports(plan, task, paths, harness_root=paths[0].parent.parent)
+
+
+def split_hash(tr, va):
+    return hashlib.sha256(np.asarray(tr, dtype='<i8').tobytes() + np.asarray(va, dtype='<i8').tobytes()).hexdigest()
+
+
+class HPOQualificationTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name).resolve()
+        self.case_number = 0
+
+    def fixture(self, kind='regression'):
+        metric = 'rmse' if kind == 'regression' else 'macro_f1'
+        cut_number = 0 if kind == 'regression' else 42
+        root = self.root/str(self.case_number)
+        self.case_number += 1
+        root.mkdir()
+        task, train, harness = [root/name for name in ['task.md', 'train.csv', 'harness.py']]
+        for path in [task, train, harness]:
+            path.write_bytes(b'fixture\n')
+        control = {'engine': 'lightgbm', 'params': {'num_leaves': 63}, 'feature_code': ''}
+        plan = {'pairs': [{'task': kind, 'cut': cut_number}], 'controls': {kind: {
+            'recipe_sha256_canonical_json': canonical(control),
+            'input_sha256': {'task.md': digest(task), 'train.csv': digest(train)}}},
+            'limits': {'study_seconds': 900, 'maximum_trials_including_anchor': 8, 'sampler_seed': 137,
+                       'tpe_startup_trials': 3, 'worker_seconds': 600, 'worker_memory_mib': 1536, 'worker_threads': 2},
+            'qualification': {'expected_source_sha256': {'worker.py': hashlib.sha256(b'pass\n').hexdigest()},
+                              'expected_harness_sha256': {'harness.py': digest(harness)}}}
+        paths = []
+        for policy in ['legacy', 'measured']:
+            output = root/policy
+            output.mkdir()
+            (output/'sources').mkdir()
+            (output/'sources/worker.py').write_bytes(b'pass\n')
+            cut = output/('cut-' + str(cut_number))
+            cut.mkdir()
+            np.savez(cut/'outer-split.npz', train=np.arange(6), validation=np.arange(6, 9))
+            row = {'cut': cut_number, 'split': {'split_sha256': split_hash(range(6), range(6, 9)), 'shared_feature_hashes': 0},
+                   'outer_split_sha256': digest(cut/'outer-split.npz'), 'outcomes': {
+                       'control': {'status': 'ok', 'metrics': {metric: 10. if kind == 'regression' else .6}, 'recipe': deepcopy(control)}},
+                   'study_allocations': {}}
+            for sampler, score in [('random', 9.8), ('tpe', 9.9)]:
+                inner = cut/sampler
+                inner.mkdir()
+                np.savez(inner/'split.npz', train=np.arange(4), validation=np.arange(4, 6))
+                candidate = deepcopy(control)
+                candidate['params']['num_leaves'] = 64 if sampler == 'random' else 80
+                row[sampler] = {'sampler': sampler, 'seed': 137, 'maximum_trials': 8, 'startup_trials': 3,
+                    'admission_policy': policy, 'control_recipe': deepcopy(control),
+                    'split': {'split_sha256': split_hash(range(4), range(4, 6)), 'scope': 'inside_outer_fitting_rows_only', 'shared_feature_hashes': 0},
+                    'trials': [{'objective_valid': True, 'status': 'ok', 'value': 10. if kind == 'regression' else .6, 'recipe': deepcopy(control)},
+                               {'objective_valid': True, 'status': 'ok', 'value': 9. if kind == 'regression' else .65, 'recipe': deepcopy(candidate)}],
+                    'attempted_trials': 2, 'completed_trials': 2, 'unattempted_trials': 6,
+                    'status': 'ok', 'best_inner_value': 9. if kind == 'regression' else .65, 'selected_recipe': candidate,
+                    'guided_successful_trials': 0, 'seconds': 150. if policy == 'measured' else 850.}
+                row['study_allocations'][sampler] = {'requested_seconds': 900, 'allocated_seconds': 900.,
+                                                    'clipped_by_common_deadline': False}
+                row['outcomes'][sampler] = {'status': 'ok', 'metrics': {metric: score if kind == 'regression' else .64 if sampler == 'random' else .65}, 'recipe': deepcopy(candidate)}
+            report = {'limits': {'admission': policy, 'trials': 8, 'study_seconds': 900, 'worker_seconds': 600,
+                                'memory_mb': 1536, 'worker_threads': 2, 'task': str(task)},
+                'spec': {'kind': kind, 'metric': metric, 'greater_is_better': kind == 'classification', 'n_train': 9,
+                         'paths': {'train': str(train)}}, 'mode': 'hpo', 'status': 'completed',
+                'source_unchanged': True, 'inputs_unchanged': True, 'task_unchanged': True, 'harness_unchanged': True,
+                'control_recipe': deepcopy(control), 'source_sha256': plan['qualification']['expected_source_sha256'],
+                'harness_sha256': plan['qualification']['expected_harness_sha256'],
+                'input_sha256': {'train': digest(train)}, 'task_sha256': digest(task), 'cuts': [row]}
+            path = output/'results.json'
+            self.write(path, report)
+            paths.append(path)
+        return plan, paths
+
+    @staticmethod
+    def write(path, report):
+        path.write_text(json.dumps(report), encoding='utf-8')
+
+    def change(self, path, action):
+        report = json.loads(path.read_text(encoding='utf-8'))
+        action(report)
+        self.write(path, report)
+
+    def test_full_allocations_allow_early_measured_stop_without_claiming_promotion(self):
+        for kind in ['regression', 'classification']:
+            plan, paths = self.fixture(kind)
+            result = qualify_reports(plan, kind, paths)
+            self.assertTrue(result['valid_equal_budget_screen'], result['errors'])
+            self.assertFalse(result['promotion'])
+            self.assertFalse(result['ml_quality_promotion_gate_evaluated'])
+            self.assertAlmostEqual(result['comparisons'][0]['tpe_minus_random']['legacy'], .1 if kind == 'regression' else .01)
+            self.assertEqual(result['comparisons'][0]['successful_guided_trials'], {'legacy': 0, 'measured': 0})
+

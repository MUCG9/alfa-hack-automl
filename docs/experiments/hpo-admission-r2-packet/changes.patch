+        self.assertIsNone(result['outer_metric_means'])
+        self.assertIn('unsuccessful', result['errors'][0]['reason'])
+
+    def test_missing_nonfinite_boolean_or_wrong_primary_metric_is_rejected(self):
+        for metrics in [{'rmse': None}, {'rmse': float('nan')}, {'rmse': float('inf')}, {'rmse': True}, {'mae': 1.}]:
+            with self.subTest(metrics=metrics):
+                plan, paths = self.fixture()

+def guard(argv,cwd,env,bundle,deadline_unix,log,timeout=480,worker_mib=1536,whole_mib=2048,clock=None):
+    """Only reviewed Python entrypoints; caller admission remains mandatory.
+
+    RSS sums are conservative sampled RSS, not PSS. Unknown identity/cleanup
+    fails closed. No process outside a new owned Popen family is terminated.
+    """
+    import psutil
+    sys.path.insert(0,str(bundle))
+    from automl_infrastructure_processes import ProcessTree
+    if not 0<timeout<=480 or not 0<worker_mib<=1536 or not worker_mib<=whole_mib<=2048:raise Blocked('invalid_worker_caps')
+    wall=time.time();mono=time.monotonic();remaining=min(timeout,450,deadline_unix-wall)
+    if any(Path(str(a)).name=='automl_worker.py' for a in argv) and clock is None:raise Blocked('model_requires_retained_common_clock')
+    if clock is not None:
+        if deadline_unix!=clock['original_deadline_unix'] or abs((wall-mono)-clock['observed_epoch_offset'])>5:raise Blocked('original_clock_reset_denied')
+        remaining=min(remaining,clock['common_monotonic_deadline']-mono)
+    if remaining<=0:raise Blocked('original_deadline_expired')
+    mono_deadline=mono+remaining
+    sources={p.name:sha(p) for p in Path(bundle).glob('*.py')}
+    script_sha=sha(__file__)
+    start_status={};peak_worker=0;peak_whole=0;errors=[];status='running';tree=None;process=None;observed=set();cleanup_confirmed=None
+    parent=psutil.Process()
+    with Path(log).open('x',encoding='utf-8') as stream:
+        try:
+            process=subprocess.Popen(argv,cwd=cwd,env=env,stdout=stream,stderr=subprocess.STDOUT,start_new_session=os.name!='nt')
+            tree=ProcessTree(process);root=psutil.Process(process.pid)
+            start_status={'pid':root.pid,'create_time':root.create_time()}
+            # Private identity receipt permits a later heartbeat to resume, not duplicate.
+            write_json(Path(log).with_suffix('.identity.json'),{**start_status,'observed_start_unix':wall,
+                'observed_start_monotonic':mono,'original_deadline_unix':deadline_unix,'effective_monotonic_deadline':mono_deadline})
+            while process.poll() is None:
+                tree.refresh();observed.update(tree.members);total=parent.memory_info().rss;worker=0
+                for identity in list(tree.members):
+                    member=tree._verified(identity)
+                    if member is None:continue
+                    memory=member.memory_info().rss;total+=memory
+                    if member.pid==process.pid:worker=memory
+                peak_worker=max(peak_worker,worker);peak_whole=max(peak_whole,total)
+                if time.time()>=deadline_unix or time.monotonic()>=mono_deadline:status='timeout';break
+                if worker>worker_mib*2**20 or total>whole_mib*2**20:status='memory_limit';break
+                time.sleep(.05)
+            if status=='running':status='completed' if process.returncode==0 else 'failed'
+        except (OSError,psutil.Error) as exc:
+            errors.append({'code':type(exc).__name__,'detail':'owned process inspection/spawn failed'});status='blocked'
+        finally:
+            if tree is not None:
+                try:
+                    tree.refresh();observed.update(tree.members);tree.terminate()
+                    cleanup_confirmed=True
+                    for pid,created in observed:
+                        try:
+                            member=psutil.Process(pid)
+                            if member.create_time()==created and member.is_running() and member.status() not in (psutil.STATUS_ZOMBIE,psutil.STATUS_DEAD):cleanup_confirmed=False
+                        except psutil.NoSuchProcess:pass
+                    if not cleanup_confirmed:raise Blocked('owned_process_still_alive')
+                except Exception as exc:errors.append({'code':type(exc).__name__,'detail':'owned cleanup not independently confirmed'});status='blocked'
+    if status!='completed' and not errors:errors.append({'code':status,'detail':'pure worker did not complete successfully'})
+    result={'status':status,'exit_code':process.returncode if process else None,'identity':start_status,
+        'start_unix':wall,'start_monotonic':mono,'deadline_unix':deadline_unix,'effective_monotonic_deadline':mono_deadline,
+        'finished_unix':time.time(),'elapsed_seconds':time.monotonic()-mono,'peak_worker_rss_mib':peak_worker/2**20,
+        'peak_whole_sampled_rss_mib':peak_whole/2**20,'first_error':errors[0] if errors else None,
+        'secondary_errors':errors[1:],'fits':0,'api_calls':0,'metrics':None,'raw_log_sha256':sha(log),
+        'harness_sha256':script_sha,'frozen_python_sha256':sources,
+        'owned_identities':[{'pid':p,'create_time':c} for p,c in sorted(observed)],'cleanup_confirmed':cleanup_confirmed,
+        'source_unchanged':sources=={p.name:sha(p) for p in Path(bundle).glob('*.py')} and script_sha==sha(__file__)}
+    if not result['source_unchanged']:result['status']='blocked'
+    write_json(Path(log).with_suffix('.receipt.json'),result)
+    return result

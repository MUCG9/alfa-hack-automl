+
+def fixture(root,regression=False):
+    target=np.arange(12,dtype=float) if regression else np.tile(['A','B','C'],4)
+    train=pd.DataFrame({'row_id':np.arange(12),'measure':np.arange(12,dtype=float),
+        'first':list('abababababab'),'second':list('xxyyxxyyxxyy'),'response':target})
+    test=train.iloc[:3].drop(columns='response').copy();test.row_id+=100
+    sample=pd.DataFrame({'row_id':test.row_id,'response':0. if regression else 'A'})
+    for frame,name in [(train,'train.csv'),(test,'test.csv'),(sample,'sample.csv')]:
+        frame.to_csv(root/name,index=False)
+    path=root/'task.md';path.write_text('Synthetic fixture only.',encoding='utf-8')
+    spec=dict(schema(),root=str(root),task_path=str(path),target='response',id='row_id',
+        output_columns=['response'],prediction_type='label',validation_strategy='group',
+        paths={'train':str(root/'train.csv'),'test':str(root/'test.csv'),
+               'sample_submission':str(root/'sample.csv')})
+    if regression:spec.update(kind='regression',metric='rmse',greater_is_better=False,classes=[],prediction_type='numeric')
+    return path,(spec,{},train,test,sample,'Synthetic fixture only.',np.arange(12))

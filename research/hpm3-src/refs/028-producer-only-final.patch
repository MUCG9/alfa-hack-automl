+def _bank_native(recorder):
+    from automl.infrastructure.hpo_bank import BankRejected,checked_refs
+    import threadpoolctl,platform,os
+    libraries=threadpoolctl.threadpool_info();actual={str(Path(sys.executable).resolve())}
+    for name,module in list(sys.modules.items()):
+        if name.split('.')[0] in {'lightgbm','numpy','pandas','scipy','sklearn','threadpoolctl'} and getattr(module,'__file__',None):
+            actual.add(str(Path(module.__file__).resolve()))
+    actual.update(str(Path(row['filepath']).resolve()) for row in libraries if row.get('filepath'))
+    import lightgbm.basic
+    actual.add(str(Path(lightgbm.basic._LIB._name).resolve()))
+    if actual!=set(recorder.request['native_refs']):raise BankRejected('actual_native_package_closure_incomplete')
+    checked_refs(recorder.request['native_refs'],recorder.checkpoint)
+    return dict(files=dict(recorder.request['native_refs']),
+        python=dict(executable=str(Path(sys.executable).resolve()),version=list(sys.version_info),
+            implementation=sys.implementation.name,cache_tag=sys.implementation.cache_tag,platform=platform.platform()),
+        threads=_bank_value(libraries,recorder.checkpoint),
+        environment={name:os.environ.get(name) for name in ('AUTOML_THREADS','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS','VECLIB_MAXIMUM_THREADS','BLIS_NUM_THREADS')})
+

+@contextmanager
+def owned_ascii_temp(root=None):
+    base=Path(root) if root is not None else Path(tempfile.gettempdir())
+    if not str(base.resolve()).isascii() or not base.is_dir():raise Blocked('owned_ascii_temp_root_unavailable')
+    with tempfile.TemporaryDirectory(prefix='automl-kernel-',dir=base) as folder:
+        yield Path(folder)

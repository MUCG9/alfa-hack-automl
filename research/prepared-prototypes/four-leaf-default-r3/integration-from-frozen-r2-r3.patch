+            selected,info=policy.default_fixed_last_slot(schema(),args(Path('task.md')),12)
+        self.assertIsNone(selected);self.assertFalse(info['source_enabled'])
+        with patch.object(policy,'DEFAULT_FIXED_CAPACITY_LAST_SLOT',True):
+            selected,info=policy.default_fixed_last_slot(schema(),args(Path('task.md')),12)
+        base=next(r for r in policy.portfolio(schema()) if r['params'].get('feature_views')=='categorical_te_pair')
+        expected=policy.normalize(dict(base,params=dict(base['params'],feature_views=FIXED_CAPACITY_METHOD)))
+        self.assertEqual(selected['params'],expected['params'])
+        self.assertEqual(policy.signature(selected),policy.signature(expected))
+        self.assertEqual(info['recipe_sha256'],policy.signature(expected))

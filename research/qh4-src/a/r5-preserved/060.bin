+def gateway_source_files(taskcfg):
+    """Independently reconstruct the exact reviewed local provider-code closure.
+
+    Every value comes from the complete task source/input union, whose raw
+    bytes and both task seals are checked before truth. This small transport
+    map grants no additional filesystem/data/model authority.
+    """
+    root=Path(taskcfg['canonical_root']);pins=taskcfg['immutable_files']
+    need(root.is_absolute() and type(pins) is dict,'absolute_gateway_source_authority_required')
+    result={}
+    for relative in GATEWAY_SOURCE_RELATIVE:
+        path=str(root/relative);expected=pins.get(path)
+        need(type(expected) is str and re.fullmatch('[0-9a-f]{64}',expected),
+             'complete_typed_gateway_source_closure_required')
+        result[path]=expected
+    return result
+
+
 def verify_usage(row,report,seal,taskcfg,check):
     output=Path(row['output']);rows=[]
     for index in range(1,report['gateway_calls']+1):

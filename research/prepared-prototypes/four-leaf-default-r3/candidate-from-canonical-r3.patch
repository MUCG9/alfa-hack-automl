+"""One-thread synthetic default-entrypoint checks; no fit, API or child worker."""
+from copy import deepcopy
+from contextlib import ExitStack,redirect_stdout
+from pathlib import Path
+from types import SimpleNamespace
+import io,json,os,runpy,socket,subprocess,sys,tempfile,unittest
+from unittest.mock import patch
+
+for name in ['AUTOML_THREADS','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS']:
+    os.environ[name]='1'
+ROOT=Path(__file__).resolve().parents[1]
+sys.path[:0]=[str(ROOT/'src'),str(ROOT)]
+import numpy as np
+import pandas as pd
+from automl.search import policy,runner
+from automl.execution import worker
+from automl.execution.feature_views import feature_view_components,FIXED_CAPACITY_METHOD,validate_fit_iterations
+from automl.infrastructure import llm_gateway as gateway
+from automl.task_understanding import semantic_inputs as semantic
+
+
+def args(path,**changes):
+    value=dict(task=path,time_budget=9900,max_experiments=12,max_planner_calls=4,
+        max_llm_calls=None,offline=True,hpo_trials=0,hpo_budget=900,hpo_sampler='tpe',
+        planner_mode='baseline',feature_selection_top_k=0,protect_original_features=False,
+        four_stage=False,validation_strategy='auto',run_name='mock-default')
+    value.update(changes);return SimpleNamespace(**value)
+
+
+def schema():
+    return {'kind':'classification','metric':'macro_f1','greater_is_better':True,
+        'text_features':[],'features':['measure','first','second'],
+        'categorical_features':['second','first'],'classes':['A','B','C']}
+
+
+def fixture(root,regression=False):
+    target=np.arange(12,dtype=float) if regression else np.tile(['A','B','C'],4)
+    train=pd.DataFrame({'row_id':np.arange(12),'measure':np.arange(12,dtype=float),
+        'first':list('abababababab'),'second':list('xxyyxxyyxxyy'),'response':target})
+    test=train.iloc[:3].drop(columns='response').copy();test.row_id+=100
+    sample=pd.DataFrame({'row_id':test.row_id,'response':0. if regression else 'A'})
+    for frame,name in [(train,'train.csv'),(test,'test.csv'),(sample,'sample.csv')]:
+        frame.to_csv(root/name,index=False)
+    path=root/'task.md';path.write_text('Synthetic fixture only.',encoding='utf-8')
+    spec=dict(schema(),root=str(root),task_path=str(path),target='response',id='row_id',
+        output_columns=['response'],prediction_type='label',validation_strategy='group',
+        paths={'train':str(root/'train.csv'),'test':str(root/'test.csv'),
+               'sample_submission':str(root/'sample.csv')})
+    if regression:spec.update(kind='regression',metric='rmse',greater_is_better=False,classes=[],prediction_type='numeric')
+    return path,(spec,{},train,test,sample,'Synthetic fixture only.',np.arange(12))
+
+
+class FourLeafDefaultTests(unittest.TestCase):
+    def setUp(self):
+        self.guards=ExitStack();self.addCleanup(self.guards.close)
+        self.forbidden={'fit':0,'api':0,'network':0,'child_worker':0}
+        def block(kind):
+            def forbidden(*a,**k):
+                self.forbidden[kind]+=1;raise AssertionError('Forbidden '+kind+' in mocked checks')
+            return forbidden
+        for target,name,kind in [(socket.socket,'connect','network'),(socket,'create_connection','network'),
+                (subprocess,'Popen','child_worker'),(runner,'request_json','api'),
+                (gateway,'request_json','api'),(semantic,'request_json','api'),(worker,'run','fit')]:
+            self.guards.enter_context(patch.object(target,name,side_effect=block(kind)))
+        self.addCleanup(lambda:self.assertEqual(self.forbidden,dict.fromkeys(self.forbidden,0)))
+
+    def run_mock(self,root,enabled,regression=False,winner='lightgbm',stop_before_last=False,cli=False,call_cap_zero=False):
+        path,data=fixture(root,regression);spec,_,train,test,sample,_,_=data
+        options=args(path);clock=[0.];calls=[];by_recipe={};captured={}
+        def split(spec,frame,hashes,seed):
+            a,b=(np.arange(8),np.arange(8,12)) if seed==42 else (np.arange(4,12),np.arange(4))
+            return a,b,{'method':'synthetic_fixed','seed':seed}
+        def mock_worker(spec,recipe,directory,split_path,timeout,full_fit=False,fit_iterations=None):
+            directory=Path(directory);directory.mkdir(parents=True)
+            selected=deepcopy(recipe);method=selected['params'].get('feature_views')
+            selected_iterations=([31,41,51,61] if method==FIXED_CAPACITY_METHOD else
+                                  [37,47] if method else 53)
+            if fit_iterations is not None:selected_iterations=deepcopy(fit_iterations)
+            validate_fit_iterations(selected,selected_iterations)
+            key=policy.signature(selected)
+            if directory.name.startswith('experiment-'):
+                index=int(directory.name.rsplit('-',1)[1])
+                value=(.6 if selected['engine']==winner else .4)+index*.001
+                if method==FIXED_CAPACITY_METHOD:value=.95
+                if regression:value=10.-value
+                by_recipe[key]=value
+                if stop_before_last and index==10:clock[0]=9000.
+            else:value=by_recipe[key]
+            charged_seconds=len(selected_iterations) if isinstance(selected_iterations,list) else 1
+            clock[0]+=charged_seconds
+            prediction=sample.copy()
+            prediction['response']=np.arange(len(sample))/10 if regression else 'A'
+            prediction.to_csv(directory/'submission.csv',index=False)
+            record={'status':'ok','recipe':selected,'metrics':{spec['metric']:value},
+                'fit_iterations':selected_iterations,'full_fit':full_fit,'feature_count':len(spec['features']),
+                'wall_seconds':charged_seconds,'submission':str(directory/'submission.csv'),'output_dir':str(directory)}
+            calls.append({'directory':directory.name,'recipe':selected,'timeout':timeout,
+                'full_fit':full_fit,'fit_iterations':deepcopy(fit_iterations),
+                'prediction_bytes':(directory/'submission.csv').read_bytes(),'value':value,
+                'charged_seconds':charged_seconds})
+            (directory/'result.json').write_text(json.dumps(record),encoding='utf-8')
+            return record
+        real_solve=runner.solve_single
+        def capture(options,task_data=None):
+            captured['args']=deepcopy(vars(options));return real_solve(options,task_data)
+        with ExitStack() as mock,redirect_stdout(io.StringIO()):
+            mock.enter_context(patch.object(policy,'DEFAULT_FIXED_CAPACITY_LAST_SLOT',enabled))
+            mock.enter_context(patch.object(runner.time,'monotonic',side_effect=lambda:clock[0]))
+            mock.enter_context(patch.object(runner,'choose_validation',side_effect=lambda s,*a:s))
+            mock.enter_context(patch.object(runner,'source_files',return_value=[]))
+            mock.enter_context(patch.object(runner,'make_split',side_effect=split))
+            mock.enter_context(patch.object(runner,'metric_context',return_value={}))
+            mock.enter_context(patch.object(runner,'run_worker',side_effect=mock_worker))
+            mock.enter_context(patch.object(runner,'read_cache',side_effect=ValueError('No mock global cache')))
+            if cli:
+                loader=mock.enter_context(patch.object(runner,'load_inputs',return_value='mock_loaded'))
+                mock.enter_context(patch.object(runner,'discover',return_value=data))
+                mock.enter_context(patch.object(runner,'solve_single',side_effect=capture))
+                argv=['solution.py',str(path),'--offline']
+                if call_cap_zero:argv.extend(['--max-llm-calls','0'])
+                mock.enter_context(patch.object(sys,'argv',argv))
+                runpy.run_path(str(ROOT/'solution.py'),run_name='__main__')
+                self.assertEqual(loader.call_args.kwargs,{'allow_llm':False})
+                report=json.loads((root/'automl_runs/run-v2/report.json').read_text(encoding='utf-8'))
+            else:report=real_solve(options,data)
+        return report,calls,(root/'submission.csv').read_bytes(),captured

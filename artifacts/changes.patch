+def verified_bundle(sources,destination):
+    sources=Path(sources);destination=Path(destination)
+    manifest=json.loads((sources/'source-manifest.json').read_text())
+    archive=sources/'kernel-source.zip'
+    if manifest['source_archive_sha256']!=ARCHIVE_SHA or sha(archive)!=ARCHIVE_SHA:raise Blocked('archive_sha_mismatch')
+    with zipfile.ZipFile(archive) as packed:
+        names=packed.namelist()
+        if len(names)!=70 or len(set(names))!=70 or set(names)!=set(manifest['flat_files_sha256']):raise Blocked('archive_inventory')
+        for name in names:
+            item=packed.getinfo(name)
+            if '/' in name or '\\' in name or stat.S_ISLNK(item.external_attr>>16) or not (name.endswith('.py') or name=='requirements.txt'):
+                raise Blocked('unsafe_archive_member')
+            if hashlib.sha256(packed.read(name)).hexdigest()!=manifest['flat_files_sha256'][name]:raise Blocked('member_sha_mismatch')
+        if manifest['flat_files_sha256']['requirements.txt']!=REQUIREMENTS_SHA:raise Blocked('requirements_changed')
+        destination.mkdir(parents=True,exist_ok=False)
+        for name in names:(destination/name).write_bytes(packed.read(name))
+    return manifest
+
+
+def verify_inputs(manifest,root):
+    paths={};receipt=[]
+    for entry in manifest['files']:
+        candidates=[p for p in (Path(root)/entry['task']).rglob(entry['name']) if p.is_file() and p.stat().st_size==entry['bytes']]
+        matched=[p for p in candidates if sha(p)==entry['sha256']]
+        if len(matched)!=1:raise Blocked('missing_ambiguous_or_corrupted_input_'+entry['task']+'_'+entry['name'])
+        paths[(entry['task'],entry['name'])]=matched[0]
+        receipt.append({k:entry[k] for k in ('task','name','bytes','sha256')})
+    if len(paths)!=10:raise Blocked('ten_original_inputs_required')
+    return paths,receipt
+

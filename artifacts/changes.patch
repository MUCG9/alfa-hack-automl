+def sha(path):
+    digest=hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for chunk in iter(lambda:stream.read(2**20),b''):digest.update(chunk)
+    return digest.hexdigest()
+
+
+def write_json(path,value):
+    path=Path(path);path.parent.mkdir(parents=True,exist_ok=True)
+    if path.exists():raise Blocked('immutable_receipt_exists')
+    path.write_text(json.dumps(value,sort_keys=True,indent=2,allow_nan=False)+'\n',encoding='utf-8')
+
+
+def require_pins():
+    actual={name:importlib.metadata.version(name) for name in PINS}
+    if actual!=PINS:raise Blocked('original_dependency_pin_mismatch')
+    return actual
+

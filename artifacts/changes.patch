+@contextmanager
+def exclusive_host_lock(path):
+    import psutil
+    path=Path(path);current=psutil.Process();identity={'pid':current.pid,'create_time':current.create_time()}
+    try:
+        with path.open('x',encoding='utf-8') as stream:json.dump(identity,stream)
+    except FileExistsError:raise Blocked('existing_owned_job_lock_no_automatic_reclaim')
+    try:yield identity
+    finally:
+        if json.loads(path.read_text())!=identity:raise Blocked('lock_ownership_changed')
+        path.unlink()

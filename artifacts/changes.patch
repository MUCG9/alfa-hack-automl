+def validate_indices(train,validation,size):
+    import numpy as np
+    for rows in (train,validation):
+        if rows.ndim!=1 or rows.dtype!=np.dtype('int64') or len(rows)==0 or rows.min()<0 or rows.max()>=size or len(np.unique(rows))!=len(rows):
+            raise Blocked('invalid_original_indices')
+    if np.intersect1d(train,validation).size:raise Blocked('partition_overlap')
+

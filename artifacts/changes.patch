+def prepare_splits(sources,inputs,private):
+    import numpy as np
+    require_pins();sources=Path(sources);private=Path(private)
+    private.mkdir(parents=True,exist_ok=False)
+    source=verified_bundle(sources,private/'frozen')
+    input_manifest=json.loads((sources/'approved-input-manifest.json').read_text())
+    paths,input_receipts=verify_inputs(input_manifest,inputs)
+    sys.path.insert(0,str(private/'frozen'))
+    from automl_task import discover
+    from automl_evaluation import choose_validation,make_time_split,make_split
+    from automl_infrastructure_observation_time import observation_values
+    cuts=json.loads((sources/'fixed-cut-manifest-r2.json').read_text())
+    completed=[]
+    for kind,task in [('regression','regression'),('classification','multiclass')]:
+        spec,_,frame,_,_,_,hashes=discover(paths[(task,'task.md')],allow_llm=False)
+        spec=choose_validation(spec,frame,mode='legacy')
+        if kind=='regression':spec.update(validation_strategy='time',time_column=spec['time_candidate']['column'])
+        for item in [c for c in cuts['cuts'] if c['kind']==kind]:
+            tr,va,details=make_time_split(spec,frame,offset=item['cut']) if kind=='regression' else make_split(spec,frame,hashes,seed=item['cut'])
+            validate_indices(tr,va,len(frame))
+            if kind=='classification' and set(hashes[tr])&set(hashes[va]):raise Blocked('feature_groups_overlap')
+            if kind=='regression':
+                times=observation_values(frame[spec['time_column']])[0].to_numpy()
+                if not max(times[tr])<min(times[va]):raise Blocked('forward_order_violated')
+            name=kind+'-'+str(item['cut'])+'.npz'
+            try:actual=exact_npz(private/name,tr,va,item['saved_npz_sha256']);raw_match=True
+            except Blocked as exc:
+                if str(exc)!='exact_original_npz_bytes_not_reproduced':raise
+                actual=sha(private/name);raw_match=False
+            completed.append({'kind':kind,'cut':item['cut'],'npz_sha256':actual,
+                'train_rows':len(tr),'validation_rows':len(va),'method':details['method'],
+                'ordered_indices_sha256':hashlib.sha256(tr.tobytes()+va.tobytes()).hexdigest(),
+                'raw_bytes_match':raw_match,'diagnostic':container_diagnostic(private/name,item['saved_npz_sha256'])})
+        # Private absolute input paths/spec/arrays are deliberately not returned.
+        write_json(private/(kind+'-spec.json'),spec)
+    if any(sha(private/'frozen'/name)!=digest for name,digest in source['flat_files_sha256'].items()):raise Blocked('frozen_source_changed')
+    verify_inputs(input_manifest,inputs)
+    return {'status':'passed' if all(c['raw_bytes_match'] for c in completed) else 'blocked',
+        'source_archive_sha256':ARCHIVE_SHA,'members':70,
+        'input_receipts':input_receipts,'cuts':completed,'fits':0,'api_calls':0,
+        'quality_metrics':{'rmse':None,'macro_f1':None},'reason':'source_only_no_models_fitted',
+        'fit_admitted':False,'byte_gate_not_relaxed':True}

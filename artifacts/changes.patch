+def retained_clock(claim,path):
+    """Retain the FIRST paired observation. Reboot/clock discontinuity blocks."""
+    path=Path(path);wall=time.time();mono=time.monotonic()
+    if path.exists():
+        value=json.loads(path.read_text())
+        if value['original_start_unix']!=claim['claimed_at_unix'] or value['original_deadline_unix']!=claim['deadline_unix']:raise Blocked('original_clock_reset_denied')
+        if abs((wall-mono)-value['observed_epoch_offset'])>5:raise Blocked('reboot_or_wall_clock_discontinuity')
+    else:
+        value={'original_start_unix':claim['claimed_at_unix'],'original_deadline_unix':claim['deadline_unix'],
+            'observed_wall':wall,'observed_monotonic':mono,'observed_epoch_offset':wall-mono,
+            'common_monotonic_deadline':mono+max(0.,claim['deadline_unix']-wall),
+            'original_claim_monotonic_start':None}
+        write_json(path,value)
+    if wall>=value['original_deadline_unix'] or mono>=value['common_monotonic_deadline']:raise Blocked('original_deadline_expired')
+    return value

+def _bank_value(value,check):
+    """Exact ordered prepared/native values; return hashes, never raw values."""
+    import hashlib
+    from automl.infrastructure.hpo_bank import BankRejected,canonical_digest
+    check()
+    if isinstance(value,pd.DataFrame):
+        return dict(type='pandas.DataFrame',shape=list(value.shape),columns=_bank_value(value.columns,check),
+            index=_bank_value(value.index,check),vectors=[_bank_value(value.iloc[:,i],check) for i in range(value.shape[1])])
+    if isinstance(value,pd.Series):
+        if isinstance(value.dtype,pd.CategoricalDtype):
+            return dict(type='pandas.Series.category',name=_bank_value(value.name,check),
+                index=_bank_value(value.index,check),ordered=value.dtype.ordered,
+                categories=_bank_value(value.cat.categories,check),codes=_bank_value(value.cat.codes.to_numpy(),check))
+        return dict(type='pandas.Series',name=_bank_value(value.name,check),dtype=str(value.dtype),
+            index=_bank_value(value.index,check),values=_bank_value(value.to_numpy(),check))
+    if isinstance(value,pd.Index):
+        return dict(type=type(value).__module__+'.'+type(value).__qualname__,name=_bank_value(value.name,check),
+            dtype=str(value.dtype),values=_bank_value(value.to_numpy(),check))
+    if isinstance(value,np.ndarray):
+        if value.dtype.hasobject:
+            digest=hashlib.sha256()
+            for index,item in enumerate(value.flat):
+                if index%4096==0:check()
+                digest.update(bytes.fromhex(canonical_digest(_bank_value(item,check))))
+        elif value.dtype.kind in 'biufcMmSU':
+            digest=hashlib.sha256()
+            # Per-row chunks avoid serializing a second full prepared matrix.
+            flat=value.reshape(-1)
+            for begin in range(0,len(flat),65536):check();digest.update(flat[begin:begin+65536].tobytes(order='C'))
+        else:raise BankRejected('unsupported_prepared_numpy_dtype')
+        check();return dict(type='numpy.ndarray',dtype=value.dtype.str,shape=list(value.shape),order='C',sha256=digest.hexdigest())
+    if isinstance(value,np.generic):
+        return dict(type='numpy.scalar',dtype=value.dtype.str,bytes=value.tobytes().hex())
+    if value is pd.NA:return dict(type='pandas.NA')
+    if value is pd.NaT:return dict(type='pandas.NaT')
+    if type(value) is float and not np.isfinite(value):
+        import struct
+        return dict(type='python.float.nonfinite',bits=struct.pack('>d',value).hex())
+    if value is None or type(value) in (bool,int,float,str,bytes):
+        # Byte values become a typed digest descriptor for JSON persistence.
+        return dict(type='python.bytes',sha256=hashlib.sha256(value).hexdigest(),length=len(value)) if type(value) is bytes else value
+    if type(value) in (list,tuple):return dict(type=type(value).__name__,items=[_bank_value(x,check) for x in value])
+    if type(value) is dict:
+        if not all(type(k) is str for k in value):raise BankRejected('unsupported_effective_dictionary_key')
+        return {k:_bank_value(v,check) for k,v in value.items()}
+    raise BankRejected('unsupported_prepared_or_effective_type')
+
+
+def _bank_callable(value,check):
+    from automl.infrastructure.hpo_bank import BankRejected,file_ref
+    import inspect,marshal,hashlib
+    if inspect.isfunction(value):
+        path=Path(value.__code__.co_filename).resolve()
+        return dict(type='PythonFunction',module=value.__module__,qualname=value.__qualname__,
+            source=file_ref(path,check),code_sha256=hashlib.sha256(marshal.dumps(value.__code__)).hexdigest(),
+            defaults=_bank_value(value.__defaults__,check),
+            closure={name:_bank_value(cell.cell_contents,check) for name,cell in zip(value.__code__.co_freevars,value.__closure__ or [])})
+    name=type(value).__module__+'.'+type(value).__qualname__
+    fields={'lightgbm.callback._EarlyStoppingCallback':('stopping_rounds','first_metric_only','verbose','min_delta'),
+        'lightgbm.callback._LogEvaluationCallback':('period','show_stdv')}
+    if name not in fields:raise BankRejected('unsupported_fit_callback')
+    return dict(type=name,source=file_ref(Path(inspect.getfile(type(value))).resolve(),check),
+        settings={key:_bank_value(getattr(value,key),check) for key in fields[name]})
+

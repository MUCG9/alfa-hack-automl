+    def _exclusive(self,path,value):
+        self.checkpoint();raw=json.dumps(value,ensure_ascii=False,allow_nan=False,indent=2).encode('utf-8')
+        need(len(raw)<=32*2**20,'bounded_bank_entry_required')
+        temporary=path.with_name(path.name+'.pending');created=False;identity=None;primary=None;trace=None;secondary=[]
+        try:
+            with temporary.open('xb') as stream:
+                created=True;observed=os.fstat(stream.fileno());identity=(observed.st_dev,observed.st_ino)
+                stream.write(raw);stream.flush();os.fsync(stream.fileno())
+            self.checkpoint()
+            # Exclusive publication: never replace any existing bank artifact.
+            os.link(temporary,path);self.checkpoint()
+        except BaseException as exc:primary=exc;trace=exc.__traceback__
+        if created:
+            try:
+                observed=temporary.stat()
+                if (observed.st_dev,observed.st_ino)==identity:temporary.unlink()
+            except FileNotFoundError:pass
+            except BaseException as exc:
+                if primary is None:primary=exc;trace=exc.__traceback__
+                else:secondary.append(type(exc).__name__)
+        if primary is not None:
+            # Revoke only the exact inode created here, even on a late pending
+            # cleanup failure. Never unlink an unrelated existing destination.
+            if identity is not None:
+                try:
+                    observed=path.stat()
+                    if not path.is_symlink() and (observed.st_dev,observed.st_ino)==identity:path.unlink()
+                except FileNotFoundError:pass
+                except BaseException as exc:secondary.append(type(exc).__name__)
+            try:primary.bank_cleanup_secondary_types=secondary
+            except BaseException:pass
+            raise primary.with_traceback(trace)
+        return dict(ref=dict(path=str(path),sha256=hashlib.sha256(raw).hexdigest(),bytes=len(raw)),
+            identity=identity)
+
+    def completed_index_ref(self):
+        return deepcopy(self._completed_index['ref']) if self._completed_index is not None else None
+
+    def revoke_completed_index(self):
+        """Bounded cleanup of our exact inode/ref; never grants fit/source authority.
+
+        No new clock or successful-sample timestamp is assigned here. Cleanup
+        remains charged to the existing outer HPO/task/parent deadlines even
+        when the original checkpoint itself caused the primary exception.
+        """
+        owned=self._completed_index
+        if owned is None:
+            return dict(schema='hpo-trial-bank-index-revocation-v1',owned_index=False,
+                removed=False,absence_confirmed=None,index=None)
+        path=Path(owned['ref']['path']);expected=owned['ref'];identity=owned['identity']
+        def same(observed):
+            return (stat.S_ISREG(observed.st_mode)
+                and (observed.st_dev,observed.st_ino)==identity
+                and observed.st_size==expected['bytes'])
+        try:observed=path.lstat()
+        except FileNotFoundError:
+            self._completed_index=None
+            return dict(schema='hpo-trial-bank-index-revocation-v1',owned_index=True,
+                removed=False,absence_confirmed=True,index=deepcopy(expected))
+        need(same(observed),'owned_completed_index_identity_changed')
+        digest=hashlib.sha256();count=0
+        with path.open('rb') as stream:
+            need(same(os.fstat(stream.fileno())),'owned_completed_index_open_identity_changed')
+            while True:
+                block=stream.read(2**20)
+                if not block:break
+                count+=len(block);need(count<=expected['bytes']<=32*2**20,'owned_completed_index_size_changed')
+                digest.update(block)
+            need(same(os.fstat(stream.fileno())),'owned_completed_index_changed_during_cleanup')
+        need(count==expected['bytes'] and digest.hexdigest()==expected['sha256'],
+            'owned_completed_index_bytes_changed')
+        need(same(path.lstat()),'owned_completed_index_replaced_before_unlink')
+        path.unlink()
+        try:path.lstat()
+        except FileNotFoundError:pass
+        else:raise BankRejected('owned_completed_index_absence_unconfirmed')
+        self._completed_index=None
+        return dict(schema='hpo-trial-bank-index-revocation-v1',owned_index=True,
+            removed=True,absence_confirmed=True,index=deepcopy(expected))
+

+                self.assertFalse(qualify_reports(plan, 'regression', paths)['valid_equal_budget_screen'])
+
+    def test_clipped_initial_allocation_is_not_equivalent_to_admission_early_stop(self):
+        for allocated, clipped in [(800., True), (900., True), (899., False)]:
+            with self.subTest(allocated=allocated, clipped=clipped):
+                plan, paths = self.fixture()
+                self.change(paths[1], lambda report: report['cuts'][0]['study_allocations']['tpe'].update(
+                    allocated_seconds=allocated, clipped_by_common_deadline=clipped))
+                result = qualify_reports(plan, 'regression', paths)
+                self.assertFalse(result['valid_equal_budget_screen'])
+                self.assertIn('externally clipped', result['errors'][0]['reason'])
+
+    def test_missing_duplicate_or_undeclared_cut_cannot_qualify(self):
+        plan, paths = self.fixture()
+        self.assertFalse(qualify_reports(plan, 'regression', paths[:1])['valid_equal_budget_screen'])
+        self.assertFalse(qualify_reports(plan, 'regression', paths + paths[:1])['valid_equal_budget_screen'])
+        self.change(paths[1], lambda report: report['cuts'][0].update(cut=99))
+        self.assertFalse(qualify_reports(plan, 'regression', paths)['valid_equal_budget_screen'])
+
+    def test_control_source_inputs_or_integrity_flag_drift_is_rejected(self):
+        changes = [lambda r: r['control_recipe']['params'].update(num_leaves=31),
+                   lambda r: r['source_sha256'].update({'worker.py': '0'*64}),
+                   lambda r: r['input_sha256'].update(train='0'*64),
+                   lambda r: r.update(task_sha256='0'*64), lambda r: r.update(harness_unchanged=False),
+                   lambda r: r['cuts'][0]['outcomes']['control']['metrics'].update(rmse=11.)]
+        for action in changes:
+            plan, paths = self.fixture()
+            self.change(paths[1], action)
+            self.assertFalse(qualify_reports(plan, 'regression', paths)['valid_equal_budget_screen'])
+
+    def test_partition_tamper_inner_outer_leakage_and_policy_split_drift_are_rejected(self):
+        plan, paths = self.fixture()
+        outer = paths[1].parent/'cut-0/outer-split.npz'
+        outer.write_bytes(outer.read_bytes() + b'!')
+        self.assertFalse(qualify_reports(plan, 'regression', paths)['valid_equal_budget_screen'])
+        plan, paths = self.fixture()
+        np.savez(paths[1].parent/'cut-0/random/split.npz', train=np.array([0, 6]), validation=np.array([4, 5]))
+        self.change(paths[1], lambda r: r['cuts'][0]['random']['split'].update(split_sha256=split_hash([0, 6], [4, 5])))
+        result = qualify_reports(plan, 'regression', paths)
+        self.assertIn('escape outer fitting', result['errors'][0]['reason'])
+        plan, paths = self.fixture()
+        for sampler in ['random', 'tpe']:
+            np.savez(paths[1].parent/('cut-0/'+sampler+'/split.npz'), train=np.array([0, 1, 4, 5]), validation=np.array([2, 3]))
+            self.change(paths[1], lambda r, s=sampler: r['cuts'][0][s]['split'].update(split_sha256=split_hash([0, 1, 4, 5], [2, 3])))
+        result = qualify_reports(plan, 'regression', paths)
+        self.assertIn('policy partitions differ', result['errors'][0]['reason'])
+
+    def test_negative_quality_remains_valid_but_numeric_failed_inner_objective_is_invalid(self):
+        plan, paths = self.fixture()
+        self.change(paths[1], lambda r: r['cuts'][0]['outcomes']['tpe']['metrics'].update(rmse=11.))
+        result = qualify_reports(plan, 'regression', paths)
+        self.assertTrue(result['valid_equal_budget_screen'])
+        self.assertGreater(result['comparisons'][0]['measured_minus_legacy']['tpe'], 0)
+        self.assertFalse(result['promotion'])

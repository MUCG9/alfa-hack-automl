+    def test_clean_known_timeout_has_no_worker_round_then_later_proposal_and_sticky_incomplete_usage(self):
+        def provider(number):
+            if number==1:return None,dict(status='error',exception_type='TimeoutError',attempts=1,
+                usage=None,usage_complete=False,parent_return_receipt=dict(path='synthetic-owned/gateway-1/supervisor.json',sha256='a'*64))
+            return json.dumps(proposal(min(number,20))),dict(status='ok',attempts=1,usage_complete=True,
+                usage={'prompt_tokens':11,'completion_tokens':7})
+        clock,gateway,worker,calls,gcalls,saved=self.harness(provider)
+        result=R.run_task(task(),clock,gateway,worker,normalizer,signature,compiler,saved.append)
+        failed=result['records'][0]
+        self.assertEqual(failed['round'],1);self.assertEqual(failed['status'],'provider_timeout')
+        self.assertIsNone(failed['scores']);self.assertIsNone(failed['signature']);self.assertIsNone(failed['checkpoint'])
+        self.assertFalse(failed['worker_attempted']);self.assertEqual(failed['error_type'],'TimeoutError')

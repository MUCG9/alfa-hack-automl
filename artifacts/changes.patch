+def child_probe(mode):
+    # Process-local CPU affinity before joblib import; no global OS changes.
+    import psutil
+    process=psutil.Process()
+    affinity=process.cpu_affinity() if hasattr(process,'cpu_affinity') else None
+    if affinity is not None:process.cpu_affinity(affinity[:2])
+    if mode=='timeout':time.sleep(20);return
+    from joblib import Parallel,delayed
+    values=Parallel(n_jobs=2,temp_folder=os.environ['JOBLIB_TEMP_FOLDER'])(delayed(pow)(i,2) for i in range(4))
+    if values!=[0,1,4,9]:raise Blocked('pure_joblib_output_changed')
+    if any(k in os.environ for k in ('OPENAI_API_KEY','OPENAI_BASE_URL','QWEN_API_KEY')):raise Blocked('credential_environment_not_stripped')
+    print(json.dumps({'status':'passed','pure_joblib_tasks':4,'fits':0,'api_calls':0,
+        'ascii_temp':os.environ['JOBLIB_TEMP_FOLDER'].isascii(),'platform_specific_windows_proof':os.name=='nt'}))
+

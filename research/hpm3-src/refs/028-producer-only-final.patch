+def _bank_before_fit(recorder,estimator,x,targets,weights,parents,kwargs,scope,rows,validation_rows):
+    from automl.infrastructure.hpo_bank import BankRejected
+    if recorder.reason is not None:return recorder.skip_fit(scope,recorder.reason)
+    try:
+        check=recorder.checkpoint
+        constructor=_bank_value(estimator.get_params(deep=False),check)
+        settings={}
+        for key,value in kwargs.items():
+            if key=='callbacks':settings[key]=[_bank_callable(item,check) for item in value]
+            elif key=='eval_metric' and callable(value):settings[key]=_bank_callable(value,check)
+            else:settings[key]=_bank_value(value,check)
+        settings['original_fitting_positions']=_bank_value(np.asarray(rows,dtype=np.int64),check)
+        settings['original_validation_positions']=_bank_value(None if validation_rows is None else np.asarray(validation_rows,dtype=np.int64),check)
+        validation=kwargs.get('eval_set',[])
+        validation_x=[_bank_value(pair[0],check) for pair in validation]
+        validation_y=[_bank_value(pair[1],check) for pair in validation]
+        native=_bank_native(recorder)
+        return recorder.before_fit(scope=scope,fit_x=_bank_value(x,check),targets=_bank_value(targets,check),
+            weights=_bank_value(weights,check),parents=_bank_value(parents,check),
+            validation_x=validation_x,validation_y=validation_y,
+            constructor=constructor,fit_settings=settings,native=native)
+    except (BankRejected,AttributeError,TypeError,ValueError) as exc:
+        return recorder.skip_fit(scope,str(exc) if isinstance(exc,BankRejected) else 'unsupported_actual_fit_descriptor_'+type(exc).__name__)
+

+def clean_environment(owned_temp,threads=2):
+    value=str(Path(owned_temp).resolve())
+    if not value.isascii():raise Blocked('ascii_temp_required')
+    env={k:v for k,v in os.environ.items() if not any(s in k.upper() for s in ('KEY','TOKEN','SECRET','AUTH','PASSWORD','PASSWD','PROXY','COOKIE'))
+         and not k.upper().startswith(('OPENAI_','QWEN_','ANTHROPIC_','HF_','HUGGINGFACE_'))}
+    for k in ('PYTHONPATH','PYTHONSTARTUP','PYTHONHOME'):env.pop(k,None)
+    env.update(TMPDIR=value,TEMP=value,TMP=value,JOBLIB_TEMP_FOLDER=value,PYTHONIOENCODING='utf-8',PYTHONUTF8='1',
+        AUTOML_THREADS=str(threads),OMP_NUM_THREADS='1',OPENBLAS_NUM_THREADS='1',MKL_NUM_THREADS='1',NUMEXPR_NUM_THREADS='1')
+    return env

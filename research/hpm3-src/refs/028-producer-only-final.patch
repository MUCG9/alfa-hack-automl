+def _bank_aggregate(job,records):
+    """Only the existing exact two-view expansion can have multiple leaves."""
+    from copy import deepcopy
+    request=job['_hpo_trial_bank'];nodes=[];reason=None
+    if request.get('supported') is not True or len(records)!=2:reason='unsupported_bank_component_graph'
+    for index,record in enumerate(records):
+        receipt=record.get('hpo_fit_identity');expected=request['leaf_path']+[index]
+        if not isinstance(receipt,dict) or receipt.get('complete') is not True or receipt.get('epoch_id')!=request['epoch_id'] or receipt.get('leaf_path')!=expected:
+            reason=reason or 'missing_or_incomplete_bank_component';continue
+        for local,node in enumerate(receipt['nodes']):
+            if node.get('index')!=local:reason=reason or 'bank_component_fit_order_changed'
+            copied=deepcopy(node);copied.update(index=len(nodes),leaf_index=local,leaf_path=expected);nodes.append(copied)
+    return dict(schema='hpo-fit-node-identities-v1',epoch_id=request['epoch_id'],leaf_path=request['leaf_path'],
+        complete=reason is None and bool(nodes),reason=reason,nodes=nodes,
+        instrumented_fit_on_rows_calls=len(nodes),actual_recursive_learner_fits=None)
 
 
